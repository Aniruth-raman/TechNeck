{
  "expo": {
    "name": "TechNeck",
    "slug": "TechNeck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TechNeck needs camera access to measure your neck angle."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.aniruth.TechNeck"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-build-properties",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "TechNeck needs camera access to measure your neck angle.",
          "enableFrameProcessors": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3b2ad51c-49df-4027-82e9-7fb835d06273"
      }
    }
  }
}
