{
  "expo": {
    "name": "TechNeck",
    "slug": "TechNeck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B10",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TechNeck uses the front camera to measure how far your neck bends. Video never leaves your device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.aniruth.TechNeck"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3b2ad51c-49df-4027-82e9-7fb835d06273"
      }
    }
  }
}
